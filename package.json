{
  "name": "dispatch-note-desktop",
  "version": "1.0.0",
  "description": "本地订单与发货单打印系统：客户定价、整单事务、Excel 导入导出、分页打印和完整备份",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "npm run electron:build",
    "build:vite": "npm run typecheck && vite build",
    "preview": "vite preview",
    "electron:dev": "tsc -p tsconfig.electron.json && concurrently -k \"vite\" \"tsc -p tsconfig.electron.json --watch\" \"wait-on tcp:5173 && set VITE_DEV_SERVER_URL=http://localhost:5173&& electron .\"",
    "electron:build": "npm run typecheck && tsc -p tsconfig.electron.json && vite build && electron-builder --win --x64",
    "electron:build:dir": "npm run typecheck && tsc -p tsconfig.electron.json && vite build && electron-builder --win --x64 --dir",
    "test": "node --test tests/*.test.cjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test:electron": "npm run build:vite && tsc -p tsconfig.electron.json && electron tests/electron-smoke.cjs",
    "check:public": "node scripts/check-public.cjs",
    "demo:screenshots": "npm run build:vite && tsc -p tsconfig.electron.json && electron scripts/capture-demo.cjs"
  },
  "build": {
    "appId": "io.github.zhangyn1203.dispatch-note-desktop",
    "productName": "发货单打印演示版",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": null,
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "发货单打印演示版"
    },
    "extraResources": [
      {
        "from": "node_modules/sql.js/dist/sql-wasm.wasm",
        "to": "sql-wasm.wasm"
      }
    ],
    "asarUnpack": [
      "node_modules/sql.js/dist/sql-wasm.wasm"
    ]
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "sql.js": "^1.11.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "~5.6.3",
    "vite": "^6.0.3",
    "wait-on": "^8.0.1"
  },
  "license": "MIT",
  "author": "ZhangYN1203",
  "repository": {
    "type": "git",
    "url": "https://github.com/ZhangYN1203/dispatch-note-desktop.git"
  },
  "bugs": {
    "url": "https://github.com/ZhangYN1203/dispatch-note-desktop/issues"
  },
  "homepage": "https://github.com/ZhangYN1203/dispatch-note-desktop#readme",
  "engines": {
    "node": ">=22"
  }
}
